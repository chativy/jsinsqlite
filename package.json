{
  "name": "jsqlite",
  "version": "0.1.0",
  "description": "Compose Node.js ESM modules from entries stored in SQLite",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./hooks": "./src/hooks.js",
    "./register": "./src/register.js",
    "./schema": "./src/schema.js"
  },
  "bin": {
    "jsqlite": "./bin/jsqlite.js"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build:pi": "node bin/jsqlite.js import ../pi/apps/p3/src/pi.ts examples/pi.sqlite pi --force",
    "demo": "node bin/jsqlite.js build examples/demo.manifest.json .tmp/demo.sqlite --force && node --import ./src/register.js examples/demo.mjs",
    "demo:pi": "npm run build:pi && node --import ./src/register.js examples/pi.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "typescript": "5.9.3"
  }
}
